        <div class="w-full max-w-md bg-parchment-50 h-full flex flex-col shadow-2xl transform transition-transform duration-300">
            <div class="p-6 bg-royalBlue-800 text-antiqueGold flex items-center justify-between border-b border-antiqueGold/30">
                <div class="flex items-center gap-2">
                    <i class="fas fa-shopping-bag"></i>
                    <h3 class="heading-font font-bold text-lg">Your Thrift Bag</h3>
                </div>
                <button onclick="toggleCart()" class="text-antiqueGold hover:text-white text-xl"><i class="fas fa-times"></i></button>
            </div>
            <div id="cartItemsContainer" class="flex-1 overflow-y-auto p-6 space-y-4">
                <!-- Cart items dynamically inserted -->
            </div>
            <div class="p-6 bg-parchment-100 border-t border-royalBlue-800/20 space-y-3">
                <div class="flex justify-between font-cinzel font-bold text-royalBlue-900 text-lg">
                    <span>Total:</span>
                    <span id="cartTotalPrice">₹0</span>
                </div>
                <button onclick="checkoutWhatsApp()" class="w-full bg-emerald-700 hover:bg-emerald-800 text-white py-3 rounded font-cinzel font-bold tracking-wider shadow flex items-center justify-center gap-2">
                    <i class="fab fa-whatsapp text-lg"></i> Checkout via WhatsApp
                </button>
            </div>
        </div>
    </div>

    <!-- PRODUCT DETAIL MODAL -->
    <div id="productModal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="bg-parchment-50 w-full max-w-2xl rounded-xl overflow-hidden shadow-2xl border-2 border-royalBlue-800/30 flex flex-col sm:flex-row relative">
            <button onclick="closeProductModal()" class="absolute top-3 right-3 z-10 w-9 h-9 rounded-full bg-royalBlue-800 text-antiqueGold flex items-center justify-center hover:bg-royalBlue-900"><i class="fas fa-times"></i></button>
            <div class="sm:w-1/2 h-64 sm:h-auto bg-parchment-200 relative">
                <img id="modalImg" src="" alt="Product" class="w-full h-full object-cover">
            </div>
            <div class="sm:w-1/2 p-6 flex flex-col justify-between space-y-4">
                <div>
                    <span id="modalCategory" class="text-xs font-cinzel uppercase tracking-widest text-royalBlue-700 font-bold block">Category</span>
                    <h3 id="modalTitle" class="heading-font font-bold text-2xl text-royalBlue-900 mt-1">Product Title</h3>
                    <p id="modalPrice" class="text-lg font-bold text-royalBlue-800 mt-2">₹0</p>
                    <div class="flex gap-2 my-2 text-xs font-bold text-royalBlue-900">
                        <span class="bg-parchment-200 px-2 py-1 rounded border border-royalBlue-800/20">Size: <span id="modalSize">M</span></span>
                        <span class="bg-parchment-200 px-2 py-1 rounded border border-royalBlue-800/20">Condition: <span id="modalCondition">Mint</span></span>
                    </div>
                    <p id="modalDesc" class="text-xs text-royalBlue-800 font-poppins leading-relaxed mt-3">Description here...</p>
                </div>
                <button id="modalAddToCartBtn" onclick="" class="w-full bg-royalBlue-800 hover:bg-royalBlue-900 text-antiqueGold py-3 rounded font-cinzel font-bold text-sm tracking-wider shadow">
                    <i class="fas fa-shopping-bag mr-2"></i> Add to Bag
                </button>
            </div>
        </div>
    </div>

    <!-- ADMIN INVENTORY MANAGEMENT MODAL -->
    <div id="adminModal" class="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="bg-parchment-50 w-full max-w-lg rounded-xl overflow-hidden shadow-2xl border-2 border-royalBlue-800">
            <div class="p-4 bg-royalBlue-800 text-antiqueGold flex items-center justify-between border-b border-antiqueGold/30">
                <div class="flex items-center gap-2">
                    <i class="fas fa-user-shield"></i>
                    <h3 class="heading-font font-bold text-base">Admin Inventory Manager</h3>
                </div>
                <button onclick="closeAdminModal()" class="text-antiqueGold hover:text-white"><i class="fas fa-times"></i></button>
            </div>
            <form id="addProductForm" onsubmit="handleAddNewItem(event)" class="p-6 space-y-4 font-poppins text-xs sm:text-sm">
                <div>
                    <label class="block font-cinzel font-bold text-royalBlue-900 mb-1">Item Title</label>
                    <input type="text" id="adminTitle" required placeholder="e.g. Vintage Embroidered Kurta" class="w-full p-2.5 rounded bg-parchment-100 border border-royalBlue-800/30 focus:outline-none focus:border-royalBlue-800">
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block font-cinzel font-bold text-royalBlue-900 mb-1">Price (₹)</label>
                        <input type="number" id="adminPrice" required placeholder="1499" class="w-full p-2.5 rounded bg-parchment-100 border border-royalBlue-800/30 focus:outline-none focus:border-royalBlue-800">
                    </div>
                    <div>
                        <label class="block font-cinzel font-bold text-royalBlue-900 mb-1">Category</label>
                        <select id="adminCategory" class="w-full p-2.5 rounded bg-parchment-100 border border-royalBlue-800/30 focus:outline-none focus:border-royalBlue-800 font-cinzel">
                            <option value="men">Men's Wear</option>
                            <option value="women">Women's Wear</option>
                            <option value="unisex">Unisex / Jackets</option>
                        </select>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block font-cinzel font-bold text-royalBlue-900 mb-1">Size</label>
                        <input type="text" id="adminSize" required placeholder="M / L / Free Size" class="w-full p-2.5 rounded bg-parchment-100 border border-royalBlue-800/30 focus:outline-none focus:border-royalBlue-800">
                    </div>
                    <div>
                        <label class="block font-cinzel font-bold text-royalBlue-900 mb-1">Condition</label>
                        <input type="text" id="adminCondition" required placeholder="Mint / Gently Used / Vintage" class="w-full p-2.5 rounded bg-parchment-100 border border-royalBlue-800/30 focus:outline-none focus:border-royalBlue-800">
                    </div>
                </div>
                <div>
                    <label class="block font-cinzel font-bold text-royalBlue-900 mb-1">Image URL</label>
                    <input type="url" id="adminImage" required placeholder="https://images.unsplash.com/..." class="w-full p-2.5 rounded bg-parchment-100 border border-royalBlue-800/30 focus:outline-none focus:border-royalBlue-800">
                    <span class="text-[10px] text-royalBlue-700 mt-1 block">Paste any valid image link (e.g. Unsplash apparel photo)</span>
                </div>
                <div>
                    <label class="block font-cinzel font-bold text-royalBlue-900 mb-1">Description</label>
                    <textarea id="adminDesc" rows="2" required placeholder="Brief story about this pre-loved piece..." class="w-full p-2.5 rounded bg-parchment-100 border border-royalBlue-800/30 focus:outline-none focus:border-royalBlue-800"></textarea>
                </div>
                <button type="submit" class="w-full bg-royalBlue-800 hover:bg-royalBlue-900 text-antiqueGold py-3 rounded font-cinzel font-bold text-sm tracking-wider shadow">
                    <i class="fas fa-plus-circle mr-2"></i> Publish to Store
                </button>
            </form>
        </div>
    </div>

    <!-- JavaScript Application Logic -->
    <script>
        // Store State (Freshly empty by default)
        let products = [];
        let cart = [];
        let currentFilter = 'all';

        // Load saved inventory from localStorage if any
        try {
            const savedProducts = localStorage.getItem('taj_vastr_products');
            if (savedProducts) {
                products = JSON.parse(savedProducts);
            }
        } catch (e) {
            products = [];
        }

        function saveProductsToStorage() {
            try {
                localStorage.setItem('taj_vastr_products', JSON.stringify(products));
            } catch (e) {}
        }

        // Render Catalog
        function renderCatalog() {
            const grid = document.getElementById('productGrid');
            const emptyState = document.getElementById('emptyCatalogState');
            
            const filtered = currentFilter === 'all' 
                ? products 
                : products.filter(p => p.category === currentFilter);

            if (filtered.length === 0) {
                grid.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');
            grid.innerHTML = filtered.map(p => `
                <div class="bg-parchment-100 border-2 border-royalBlue-800/20 rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition duration-300 flex flex-col group">
                    <div class="relative h-72 bg-parchment-200 overflow-hidden cursor-pointer" onclick="openProductModal(${p.id})">
                        <img src="${p.image}" alt="${p.title}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                        <span class="absolute top-3 left-3 bg-royalBlue-800 text-antiqueGold text-[10px] font-cinzel font-bold px-2.5 py-1 rounded shadow uppercase tracking-wider">
                            ${p.category}
                        </span>
                        <span class="absolute top-3 right-3 bg-parchment-50/90 text-royalBlue-900 text-xs font-bold px-2 py-1 rounded shadow">
                            Size: ${p.size}
                        </span>
                    </div>
                    <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
                        <div>
                            <h4 onclick="openProductModal(${p.id})" class="heading-font font-bold text-lg text-royalBlue-900 cursor-pointer hover:text-royalBlue-700 transition">
                                ${p.title}
                            </h4>
                            <div class="flex items-center justify-between mt-2">
                                <span class="text-lg font-bold text-royalBlue-800">₹${p.price}</span>
                                <span class="text-xs text-royalBlue-700 font-semibold bg-parchment-200 px-2 py-0.5 rounded">${p.condition}</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-2 pt-2 border-t border-royalBlue-800/10">
                            <button onclick="openProductModal(${p.id})" class="flex-1 bg-parchment-200 hover:bg-parchment-300 text-royalBlue-900 py-2.5 rounded font-cinzel text-xs font-bold tracking-wider border border-royalBlue-800/30 transition">
                                View Details
                            </button>
                            <button onclick="addToCart(${p.id})" class="bg-royalBlue-800 hover:bg-royalBlue-900 text-antiqueGold px-4 py-2.5 rounded text-xs font-bold shadow transition" title="Add to Bag">
                                <i class="fas fa-shopping-bag"></i>
                            </button>
                            <button onclick="deleteProduct(${p.id})" class="bg-red-900/10 hover:bg-red-900 hover:text-white text-red-800 px-3 py-2.5 rounded text-xs transition" title="Remove Listing">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        // Filter handler
        function filterCatalog(category) {
            currentFilter = category;
            document.querySelectorAll('.filter-btn').forEach(btn => {
                if (btn.getAttribute('data-category') === category) {
                    btn.className = "filter-btn px-4 py-2 rounded bg-royalBlue-800 text-antiqueGold border border-antiqueGold/40 shadow transition";
                } else {
                    btn.className = "filter-btn px-4 py-2 rounded bg-parchment-200 text-royalBlue-900 hover:bg-parchment-300 border border-royalBlue-800/30 transition";
                }
            });
            renderCatalog();
        }

        // Admin Modal Controls
        function openAdminModal() {
            document.getElementById('adminModal').classList.remove('hidden');
        }
        function closeAdminModal() {
            document.getElementById('adminModal').classList.add('hidden');
            document.getElementById('addProductForm').reset();
        }

        // Add New Item Handler
        function handleAddNewItem(e) {
            e.preventDefault();
            const newItem = {
                id: Date.now(),
                title: document.getElementById('adminTitle').value,
                price: parseFloat(document.getElementById('adminPrice').value),
                category: document.getElementById('adminCategory').value,
                size: document.getElementById('adminSize').value,
                condition: document.getElementById('adminCondition').value,
                image: document.getElementById('adminImage').value,
                description: document.getElementById('adminDesc').value
            };
            products.unshift(newItem);
            saveProductsToStorage();
            closeAdminModal();
            renderCatalog();
        }

        // Delete Product
        function deleteProduct(id) {
            if (confirm('Are you sure you want to remove this listing?')) {
                products = products.filter(p => p.id !== id);
                saveProductsToStorage();
                renderCatalog();
            }
        }

        // Product Modal Details
        function openProductModal(id) {
            const p = products.find(item => item.id === id);
            if (!p) return;
            document.getElementById('modalImg').src = p.image;
            document.getElementById('modalCategory').innerText = p.category.toUpperCase() + ' WEAR';
            document.getElementById('modalTitle').innerText = p.title;
            document.getElementById('modalPrice').innerText = '₹' + p.price;
            document.getElementById('modalSize').innerText = p.size;
            document.getElementById('modalCondition').innerText = p.condition;
            document.getElementById('modalDesc').innerText = p.description;
            document.getElementById('modalAddToCartBtn').setAttribute('onclick', `addToCart(${p.id}); closeProductModal();`);
            document.getElementById('productModal').classList.remove('hidden');
        }
        function closeProductModal() {
            document.getElementById('productModal').classList.add('hidden');
        }

        // Cart Drawer Controls
        function toggleCart() {
            const drawer = document.getElementById('cartDrawer');
            drawer.classList.toggle('hidden');
            renderCartItems();
        }

        function addToCart(id) {
            const p = products.find(item => item.id === id);
            if (!p) return;
            const existing = cart.find(item => item.id === id);
            if (existing) {
                existing.qty += 1;
            } else {
                cart.push({ ...p, qty: 1 });
            }
            updateCartCount();
            toggleCart();
        }

        function removeFromCart(id) {
            cart = cart.filter(item => item.id !== id);
            updateCartCount();
            renderCartItems();
        }

        function updateCartCount() {
            const count = cart.reduce((sum, item) => sum + item.qty, 0);
            document.getElementById('cartCount').innerText = count;
        }

        function renderCartItems() {
            const container = document.getElementById('cartItemsContainer');
            let total = 0;
            if (cart.length === 0) {
                container.innerHTML = `<p class="text-center text-royalBlue-700 py-8 font-poppins text-sm">Your thrift bag is currently empty.</p>`;
                document.getElementById('cartTotalPrice').innerText = '₹0';
                return;
            }
            container.innerHTML = cart.map(item => {
                total += item.price * item.qty;
                return `
                    <div class="flex items-center gap-4 bg-parchment-100 p-3 rounded-lg border border-royalBlue-800/20">
                        <img src="${item.image}" class="w-16 h-16 object-cover rounded">
                        <div class="flex-1">
                            <h4 class="heading-font font-bold text-sm text-royalBlue-900">${item.title}</h4>
                            <p class="text-xs text-royalBlue-700">₹${item.price} × ${item.qty}</p>
                        </div>
                        <button onclick="removeFromCart(${item.id})" class="text-red-700 hover:text-red-900 p-2"><i class="fas fa-trash"></i></button>
                    </div>
                `;
            }).join('');
            document.getElementById('cartTotalPrice').innerText = '₹' + total;
        }

        function checkoutWhatsApp() {
            if (cart.length === 0) {
                alert('Your bag is empty!');
                return;
            }
            let message = "Hello Taj Vastr Team! I would like to purchase the following pre-loved items:\n\n";
            let total = 0;
            cart.forEach(item => {
                message += `- ${item.title} (Size: ${item.size}) - ₹${item.price} x ${item.qty}\n`;
                total += item.price * item.qty;
            });
            message += `\nTotal Amount: ₹${total}\n\nPlease confirm availability and shipping details!`;
            const encoded = encodeURIComponent(message);
            window.open(`https://wa.me/917820047429?text=${encoded}`, '_blank');
        }

        function toggleMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            menu.classList.toggle('hidden');
        }

        // Initialize empty catalog on load
        renderCatalog();
    </script>
</body>
</html>
